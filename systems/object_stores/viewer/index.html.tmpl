          <text class="bm" x="14" y="104">JDBC  localhost:10000</text>
          <text class="bm" x="14" y="122">REST  localhost:8888</text>
          <text class="bm" x="14" y="150">Metastore: usl_demo</text>
          <text class="bm" x="14" y="168">  sic_edgar_usl, 2 tables</text>
          <text class="bm" x="14" y="196">Lightning databases:</text>
          <text class="bm" x="14" y="214">  COMPANY_DNS, SEC_DATA</text>
