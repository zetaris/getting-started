<script>
(function () {
  var NAMES = ['analysis', 'topology', 'proof', 'live'];
  var tabs = [].slice.call(document.querySelectorAll('.tab'));
  function show(name) {
    tabs.forEach(function (t) {
      var on = t.id === 'tab-' + name;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
    try { history.replaceState(null, '', '#' + name); } catch (e) {}
  }
  tabs.forEach(function (t) {
    t.addEventListener('click', function () { show(t.id.replace('tab-', '')); });
    t.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      var i = tabs.indexOf(t), n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      n.focus(); show(n.id.replace('tab-', ''));
    });
  });
  var h = (location.hash || '').replace('#', '');
  if (NAMES.indexOf(h) >= 0) show(h);

  /* copy buttons: copy the text of the <pre> they point at */
  function fallbackCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    var ok = false; try { ok = document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta); return ok;
  }
  [].slice.call(document.querySelectorAll('.copy')).forEach(function (b) {
    b.addEventListener('click', function () {
      var pre = document.getElementById(b.getAttribute('data-target'));
      if (!pre) return;
      var text = pre.textContent;
      function done(ok) {
        b.textContent = ok ? 'Copied' : 'Select and copy';
        if (ok) b.classList.add('done');
        setTimeout(function () { b.textContent = 'Copy'; b.classList.remove('done'); }, 1800);
        if (!ok) { var r = document.createRange(); r.selectNodeContents(pre); var s = getSelection(); s.removeAllRanges(); s.addRange(r); }
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(fallbackCopy(text)); });
      } else { done(fallbackCopy(text)); }
    });
  });

  /* conformance report loader: the file is read here and goes nowhere; everything is added with textContent */
  (function () {
    var input = document.getElementById('reportFile'), hint = document.getElementById('reportHint'), err = document.getElementById('reportErr');
    var view = document.getElementById('reportView'), clear = document.getElementById('reportClear');
    function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = String(text); return e; }
    function fail(msg) { err.textContent = msg; err.hidden = false; view.hidden = true; clear.hidden = true; }
    var PILL = { PASS: 'good', INFO: 'info', SKIP: 'skip', FAIL: 'bad' };
    function table(heads, rows) {
      var wrap = el('div', 'tbl-wrap'), tb = el('table'), th = el('thead'), tr = el('tr');
      heads.forEach(function (h) { tr.appendChild(el('th', null, h)); }); th.appendChild(tr); tb.appendChild(th);
      var body = el('tbody'); rows.forEach(function (r) { body.appendChild(r); }); tb.appendChild(body); wrap.appendChild(tb); return wrap;
    }
    function render(d) {
      view.textContent = '';
      var bad = d.result !== 'PASS', s = d.summary || {};
      var v = el('div', 'verdict' + (bad ? ' bad' : '')), meta = el('div', 'meta');
      v.appendChild(el('div', 'big', d.result));
      [['Store', (d.store || {}).name], ['Generated', d.generated_at], ['Scope', d.scope],
       ['Checks', (s.pass || 0) + ' PASS, ' + (s.fail || 0) + ' FAIL, ' + (s.skip || 0) + ' SKIP, ' + (s.info || 0) + ' INFO']].forEach(function (m) {
        var sp = el('span'); sp.appendChild(el('b', null, m[0] + ' ')); sp.appendChild(document.createTextNode(String(m[1] == null ? '' : m[1]))); meta.appendChild(sp);
      });
      v.appendChild(meta); view.appendChild(v);
      var rows = d.checks.map(function (c) {
        var tr = el('tr'), a = el('td'), b = el('td'), x = el('td');
        a.appendChild(el('span', 'pill ' + (PILL[c.status] || 'skip'), c.status));
        b.appendChild(document.createTextNode(String(c.title))); if (c.required === false) b.appendChild(el('span', 'rep-opt', 'optional'));
        x.appendChild(document.createTextNode(String(c.detail || '')));
        (c.notes || []).forEach(function (n) { x.appendChild(el('span', 'rep-note', n)); });
        tr.appendChild(a); tr.appendChild(b); tr.appendChild(x); return tr;
      });
      view.appendChild(table(['Status', 'Check', 'Detail'], rows));
      d.checks.forEach(function (c) {
        var st = c.data && c.data.stages; if (!Array.isArray(st) || !st.length) return;
        var det = el('details'), sm = el('summary', null, c.title + ': stages');
        det.appendChild(sm);
        det.appendChild(table(['Stage', 'Rows', 'Result'], st.map(function (g) {
          var tr = el('tr'); tr.appendChild(el('td', null, g.stage)); tr.appendChild(el('td', 'num', g.rows)); tr.appendChild(el('td', null, g.result)); return tr;
        })));
        view.appendChild(det);
      });
      if ((d.observations || []).length) {
        var h = el('h3', null, 'Observations'), ul = el('ul'); view.appendChild(h);
        d.observations.forEach(function (o) { ul.appendChild(el('li', null, o)); }); view.appendChild(ul);
      }
      err.hidden = true; view.hidden = false; clear.hidden = false;
    }
    function load(text, name, auto) {
      var d;
      try { d = JSON.parse(text); } catch (e) { return fail('That file is not valid JSON.'); }
      if (!d || d.kind !== 'zetaris-object-store-report') return fail('That is not a conformance report written by report.py.');
      if (d.schema_version !== 1) return fail('This viewer reads report schema version 1; the file is version ' + d.schema_version + '.');
      if (!Array.isArray(d.checks) || !['PASS', 'FAIL', 'INCOMPLETE'].includes(d.result)) return fail('The report is incomplete: it has no checks or no result.');
      render(d); hint.textContent = auto ? 'Showing the newest report, ' + name + ', from reports/ on this computer.' : 'Showing ' + name + '. Nothing was uploaded.';
    }
    /* server mode: the newest report from reports/; on a static page or with no report this stays silent */
    var manual = false, shown = '';
    function auto() {
      if (manual || !window.fetch) return;
      fetch('/api/report/latest', { cache: 'no-store' }).then(function (r) { return r.json().then(function (b) { return [r.status, b]; }); }).then(function (x) {
        var code = x[0], b = x[1];
        if (code === 200 && b.ok && b.name !== shown) { shown = b.name; load(JSON.stringify(b.report), b.name, true); }
        else if (code !== 200 && code !== 404 && b && b.error) { fail(String(b.error)); }
      }).catch(function () {});
    }
    auto();
    document.addEventListener('visibilitychange', function () { if (!document.hidden) auto(); });
    input.addEventListener('change', function () {
      var f = input.files && input.files[0]; if (!f) return;
      manual = true;
      if (f.size > 1024 * 1024) return fail('That file is larger than 1 MB, so it is not a report.');
      var rd = new FileReader(); rd.onload = function () { load(String(rd.result), f.name); }; rd.onerror = function () { fail('The file could not be read.'); };
      rd.readAsText(f);
    });
    clear.addEventListener('click', function () { manual = true; view.textContent = ''; view.hidden = true; err.hidden = true; clear.hidden = true; input.value = ''; hint.textContent = 'No report loaded.'; });
  })();
  /* live SQL tab */
  (function () {
    var dot = document.getElementById('liveDot'), info = document.getElementById('liveInfo'), help = document.getElementById('liveHelp');
    var sql = document.getElementById('sql'), runBtn = document.getElementById('runBtn'), csvBtn = document.getElementById('csvBtn');
    var errBox = document.getElementById('liveErr'), meta = document.getElementById('resMeta'), wrap = document.getElementById('resWrap');
    var limitSel = document.getElementById('limitSel'), last = null, connected = false;
    function setState(on, text, extra) {
      connected = on; dot.className = 'dot ' + (on ? 'on' : 'off'); dot.textContent = text; info.textContent = extra || ''; help.hidden = on;
    }
    function health() {
      return fetch('api/health', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (j) {
        if (j && j.ok) setState(true, 'Connected over ' + String(j.channel).toUpperCase(), j.readOnly ? 'Read-only' : 'Read and write enabled');
        else setState(false, 'Not connected', '');
      }).catch(function () { setState(false, 'Not connected', ''); });
    }
    document.getElementById('tab-live').addEventListener('click', health);
    if ((location.hash || '') === '#live') health();
    [].slice.call(document.querySelectorAll('#presets .chip')).forEach(function (c) {
      c.addEventListener('click', function () { sql.value = c.getAttribute('data-sql'); sql.focus(); });
    });
    function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    function show(j) {
      last = j;
      var h = '<table><thead><tr><th class="rn">#</th>' + j.columns.map(function (c) { return '<th>' + esc(c) + '</th>'; }).join('') + '</tr></thead><tbody>';
      j.rows.forEach(function (r, i) {
        h += '<tr><td class="rn">' + (i + 1) + '</td>' + r.map(function (v) {
          return v === null ? '<td class="nul">NULL</td>' : '<td title="' + esc(v) + '">' + esc(v) + '</td>';
        }).join('') + '</tr>';
      });
      wrap.innerHTML = h + '</tbody></table>'; wrap.hidden = false;
      meta.innerHTML = '<span><b>' + j.rowCount.toLocaleString() + '</b> row' + (j.rowCount === 1 ? '' : 's') + '</span><span><b>' + j.columns.length + '</b> column' + (j.columns.length === 1 ? '' : 's') + '</span><span><b>' + j.ms.toLocaleString() + ' ms</b></span>' + (j.truncated ? '<span><b>Truncated</b> at ' + j.limit.toLocaleString() + ' rows. Raise the limit or add a LIMIT.</span>' : '');
      meta.hidden = false; csvBtn.hidden = false;
    }
    function run() {
      errBox.hidden = true; runBtn.disabled = true; runBtn.textContent = 'Running';
      fetch('api/query', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-SIC-Viewer': '1' }, body: JSON.stringify({ sql: sql.value, limit: +limitSel.value }) })
        .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'The server sent a reply that is not JSON.' }; }); })
        .then(function (j) {
          if (j.ok) { setState(true, dot.textContent.indexOf('Connected') === 0 ? dot.textContent : 'Connected', info.textContent); show(j); }
          else { wrap.hidden = true; meta.hidden = true; csvBtn.hidden = true; errBox.innerHTML = '<b>The query did not run.</b> ' + esc(j.error || 'Unknown error'); errBox.hidden = false; }
        })
        .catch(function () { wrap.hidden = true; meta.hidden = true; csvBtn.hidden = true; setState(false, 'Not connected', ''); })
        .then(function () { runBtn.disabled = false; runBtn.textContent = 'Run query'; });
    }
    runBtn.addEventListener('click', run);
    sql.addEventListener('keydown', function (e) { if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); run(); } });
    csvBtn.addEventListener('click', function () {
      if (!last) return;
      function q(v) { v = v === null ? '' : String(v); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; }
      var text = [last.columns.map(q).join(',')].concat(last.rows.map(function (r) { return r.map(q).join(','); })).join('\n');
      function done(ok) { csvBtn.textContent = ok ? 'Copied' : 'Copy failed'; setTimeout(function () { csvBtn.textContent = 'Copy as CSV'; }, 1600); }
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(fallbackCopy(text)); });
      else done(fallbackCopy(text));
    });
  })();
})();
</script>
</body>
</html>
