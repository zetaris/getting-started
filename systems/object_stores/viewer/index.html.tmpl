          <text class="bm" x="14" y="130">JDBC driver JAR, JDK 17</text>
          <text class="bm" x="14" y="154">.env.local holds the keys</text>
        </g>
        <g transform="translate(420,40)">
          <rect class="box usl" width="300" height="320" rx="4"/>
          <rect class="bar-usl" x="0" y="0" width="300" height="5"/>
