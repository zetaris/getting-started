        <defs>
          <marker id="p-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="currentColor" style="color:var(--head)"/></marker>
          <marker id="p-arr-s" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="currentColor" style="color:var(--cyan)"/></marker>
        </defs>

        <g transform="translate(20,130)">
          <rect class="box" width="230" height="190" rx="4"/>
