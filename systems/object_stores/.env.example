# Copy this file to .env.local and fill it in.
# .env.local holds secrets. Never commit it and never put it in a ZIP you share.
# Every script reads it and never prints the keys.
# Generated from settings.json. Edit settings.json, not this file.
# A line without a leading # is required. A line with one is optional, and shows the default.

# --- Zetaris -------------------------------------------------------------------
# Where Zetaris runs and who you are on it. A local install needs only the
# login, the API key, the user agent and the driver path.

# Your Zetaris user id, normally an email address. Used for JDBC and to
# fetch the OpenAPI spec.
# Example: <your Zetaris user id>
ZETARIS_USERNAME=

# Secret. Your Zetaris password.
# Example: <your Zetaris password>
ZETARIS_PASSWORD=

# Secret. An API key you create yourself in the Zetaris GUI. Used by
# storage_setting.py and by the viewer server over REST. The scripts never
# create one.
# Example: <API key created in the Zetaris GUI>
ZETARIS_API_KEY=

# Sent to the public SEC EDGAR and company-dns APIs, which ask callers to
# identify themselves. Use an app name and a real contact email. The scripts
# refuse the placeholder.
# Example: <app name> <contact email>
ZETARIS_USER_AGENT=

# Full path to the Zetaris JDBC driver JAR. Needed for JDBC, which is the
# default channel.
# Example: /full/path/to/ndp-jdbc-driver-<version>-driver.jar
ZETARIS_JDBC_JAR=

# JDBC URL of the instance.
# ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000

# REST API base URL of the instance.
# ZETARIS_REST_URL=http://localhost:8888/api/v1.0

# Organization id sent with REST calls.
# ZETARIS_ORG_ID=1

# --- S3-compatible object store ------------------------------------------------
# The store the USL tables are written to.

# The S3 endpoint URL, with https:// and no bucket or path.
# Example: https://<your S3 endpoint>
S3_ENDPOINT_URL=

# An existing bucket.
# Example: <bucket name>
S3_BUCKET=

# Secret. Access key id.
# Example: <access key>
S3_ACCESS_KEY=

# Secret. The access key's secret. The MATERIALIZE statement carries it, and
# the instance may keep that statement in query history, so use a key you
# can rotate.
# Example: <secret key>
S3_SECRET_KEY=

# Your own folder in the bucket. Everything the test writes goes under it,
# so people who share a bucket do not collide. Blank means usl-test- plus
# your login name. Letters, digits, - _ . and / only; it is lower-cased.
# Example: <your own folder, for example jane-usl-test>
# S3_PREFIX=

# Region name sent to the store. Most non-AWS stores ignore it, but some
# check it.
# S3_REGION=us-east-1

# path or virtual. Also sets useS3PathStyleAccess for Zetaris. probe_s3.py
# shows which one your store accepts.
# S3_ADDRESSING=path

# PEM file of trusted CAs, for a store with a private certificate authority.
# Default is the CA file Python trusts. TLS verification is never turned
# off.
# Example: /path/to/ca.pem
# S3_CA_BUNDLE=

# The Zetaris storage setting id, so materialize_usl_table.py does not need
# --setting-id.
# Example: <id printed by storage_setting.py create>
# S3_STORAGE_SETTING_ID=

# --- Display names -------------------------------------------------------------
# Only used to label the viewer and the documents. They never change what
# the scripts do.

# Vendor of the object store, shown in the viewer and the documents. Blank
# leaves it out.
# Example: <vendor name>
# S3_STORE_VENDOR=

# Product name of the object store, shown in the viewer and the documents.
# Blank shows a generic name.
# Example: <product name>
# S3_STORE_PRODUCT=
