# Copy this file to .env and fill in your own values -- .env is gitignored,
# .env.example is not. Never put real credentials in this file.
#
# The starter public-S3 recipes use isS3BucketPublic "true" and do not need
# AWS keys. These fields are optional for your own authenticated AWS work;
# setting them here does not configure credentials in the Zetaris server.
# See open_data/parquet_csv/HOWTO.md, section 2.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# PostgreSQL connection check: deno task ping:postgres or python3 scripts/ping_postgres.py
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Use verify-full for TLS with certificate verification, or disable without TLS.
PGSSLMODE=disable

# Zetaris HTTP API scripts (TypeScript and Python versions in scripts/).
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
# Set either an API token or a username and password for POST /api/auth/login.
ZETARIS_API_TOKEN=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Optional: choose a compute engine and cap rows returned by run-query.
ZETARIS_ENGINE_ID=
ZETARIS_QUERY_LIMIT=1000
