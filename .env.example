# Copy this file to .env and fill in your own values -- .env is gitignored,
# .env.example is not. Never put real credentials in this file.
#
# Needed because Zetaris's S3A connector always signs S3 requests -- even
# the publicly-readable buckets in open_data/parquet_csv/ need a real AWS
# IAM key pair. A minimal free-tier IAM user with just s3:GetObject and
# s3:ListBucket permissions is enough (it doesn't need to own any of these
# buckets). See open_data/parquet_csv/HOWTO.md, section 2.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
