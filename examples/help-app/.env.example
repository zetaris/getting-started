# Settings for examples/help-app. Add them to the repo's .env.local (the only env file the
# repo reads); the Zetaris settings (ZETARIS_REST_URL, ZETARIS_API_KEY, ZETARIS_ORG_ID) are
# already documented in the repo's .env.example. Placeholders only: never commit real values.

# Milvus as the Zetaris containers reach it (use host.docker.internal for a Milvus on this machine).
MILVUS_URI=http://host.docker.internal:19530
# Milvus as this machine reaches it (the scripts create the collection through its REST API).
MILVUS_HOST_URI=http://127.0.0.1:19530
# Local Milvus default; use your own token for a real deployment.
MILVUS_TOKEN=root:Milvus
HELP_COLLECTION=help_index
# In-engine embedding model: e5-small-v2, bge-small-en-v1.5 or all-minilm-l6-v2 (all 384 dimensions).
HELP_EMBEDDING_MODEL=e5-small-v2
HELP_CONTAINER=help_app
# Pinned answers are embedded into their own collection; a past answer is shown when its
# similarity to the new question is at least HELP_PIN_THRESHOLD (0.82 was chosen for e5-small-v2).
HELP_PINS_COLLECTION=help_pins
HELP_PIN_THRESHOLD=0.82

# Model for Example mode (generated examples). Falls back to OLLAMA_MODEL when empty.
# See docs/evidence.md for the bake-off that picked a default.
HELP_EXAMPLE_MODEL=
# Rows (segments) per ingest pipeline run.
HELP_BATCH=100

# Postgres for the doc catalog and pin log (compose/docker-compose.yml, service "postgres").
# Host and port are as the Zetaris containers reach it. Choose your own password.
HELP_PG_HOST=host.docker.internal
HELP_PG_PORT=5434
HELP_PG_DB=help
HELP_PG_USER=help
HELP_PG_PASSWORD=

# LLM for Answer and Example modes. Leave empty to use Search only.
# The URL is as the Zetaris containers reach it, for example http://host.docker.internal:11434.
OLLAMA_URL=
OLLAMA_MODEL=

# The app's own address. It has no login, so it binds to this machine only unless you change it.
HELP_HOST=127.0.0.1
HELP_PORT=8000
