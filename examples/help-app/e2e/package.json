{
  "name": "help-app-e2e",
  "private": true,
  "type": "module",
  "description": "End-to-end tests for the help app. Node and Playwright; the app itself is Deno.",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "cd .. && deno task build",
    "test": "npm run build && playwright test",
    "screenshots": "node support/screenshots.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
