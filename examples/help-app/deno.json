{
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check core/*.ts scripts/*.ts routes islands components main.ts client.ts utils.ts",
    "test": "deno test --allow-read --allow-env --allow-net=jsr.io,npmjs.org core/ components/ routes/",
    "help:verify": "deno run --allow-read --allow-env --allow-run=find scripts/verify.ts",
    "help:ingest": "deno run --allow-read --allow-write=.cache --allow-net --allow-env scripts/ingest.ts",
    "help:doctor": "deno run --allow-read --allow-net --allow-env scripts/doctor.ts",
    "help:fetch-kbase": "deno run --allow-net=kbase.zetaris.com --allow-read=.cache --allow-write=corpus/kbase,.cache scripts/fetch_kbase.ts",
    "help:smoke": "deno run --allow-read --allow-write=.cache --allow-net --allow-env scripts/smoke.ts",
    "help:answer": "deno run --allow-read --allow-net --allow-env scripts/answer_smoke.ts",
    "help:usl": "deno run --allow-read --allow-net --allow-env --allow-run=python3 scripts/build_usl.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "deno run --allow-read --allow-env --allow-net scripts/start.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.13",
    "@b-fuze/deno-dom": "jsr:@b-fuze/deno-dom@0.1.49",
    "turndown": "npm:turndown@7.2.0",
    "turndown-plugin-gfm": "npm:turndown-plugin-gfm@1.0.2",
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "marked": "npm:marked@^15.0.12"
  },
  "fmt": {
    "exclude": [
      "corpus/",
      ".cache/",
      "_fresh/",
      "node_modules/",
      "e2e/node_modules/",
      "e2e/playwright-report/",
      "e2e/test-results/"
    ]
  },
  "lint": {
    "exclude": [
      "corpus/",
      ".cache/",
      "_fresh/",
      "node_modules/",
      "e2e/node_modules/",
      "e2e/playwright-report/",
      "e2e/test-results/"
    ],
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "nodeModulesDir": "manual",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  },
  "exclude": [
    "**/_fresh/*",
    "node_modules/",
    "e2e/"
  ]
}
